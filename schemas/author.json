{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nishiuriraku/easy-cursor-swap-index/schemas/author.json",
  "title": "Author Public Key Record",
  "description": "1 著者 = 1 ファイル。authors/<github>.json として配置する。",
  "type": "object",
  "required": ["github", "display_name", "public_key"],
  "additionalProperties": false,
  "properties": {
    "github": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38}[A-Za-z0-9])?$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "public_key": {
      "type": "string",
      "description": "Ed25519 公開鍵 (32 バイトの Base64, 通常 44 文字)。",
      "minLength": 43,
      "maxLength": 44
    },
    "historical_keys": {
      "type": "object",
      "description": "ローテーションで失効した過去鍵。{ key_id_hex16: pubkey_b64 }",
      "patternProperties": {
        "^[0-9a-fA-F]{16}$": {
          "type": "string",
          "minLength": 43,
          "maxLength": 44
        }
      },
      "additionalProperties": false
    }
  }
}
