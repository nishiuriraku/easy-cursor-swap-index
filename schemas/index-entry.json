{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nishiuriraku/easy-cursor-swap-index/schemas/index-entry.json",
  "title": "Marketplace Index Entry",
  "description": "1 テーマ = 1 ファイル。entries/<uuid>.json として配置する。",
  "type": "object",
  "required": [
    "id",
    "name",
    "author",
    "author_github",
    "author_pubkey_id",
    "sha256",
    "signature",
    "download_url",
    "version",
    "included_roles"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "description": "UUID v4。themes/<id>.cursorpack のファイル名と一致。"
    },
    "name": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "required": ["ja", "en"],
          "properties": {
            "ja": { "type": "string" },
            "en": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    },
    "description": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "properties": {
            "ja": { "type": "string" },
            "en": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    },
    "author": { "type": "string" },
    "author_github": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38}[A-Za-z0-9])?$",
      "description": "GitHub username。authors/<github>.json と一致。"
    },
    "author_pubkey_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{16}$",
      "description": "著者公開鍵の SHA-256 先頭 16 文字 hex。"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "signature": {
      "type": "string",
      "description": "Ed25519 署名 (Base64, 64 バイト = 88 文字)。",
      "minLength": 86,
      "maxLength": 92
    },
    "download_url": {
      "type": "string",
      "format": "uri"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 52428800
    },
    "homepage": { "type": "string", "format": "uri" },
    "included_roles": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "contains": { "const": "Arrow" },
      "description": "Arrow ロールは必須。"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["pixel", "minimal", "animated", "dark", "light", "anime", "retro", "neon"]
      }
    },
    "highlight": {
      "type": ["string", "null"],
      "enum": ["new", "popular", null]
    },
    "download_count": {
      "type": "integer",
      "minimum": 0
    },
    "verified": { "type": "boolean" },
    "published_at": { "type": "string", "format": "date-time" }
  }
}
